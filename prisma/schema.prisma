// Municipal Governance & Buildability - Michigan
// Zillow-style Snapshot + Moody's-style Details

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Jurisdiction {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  type              String   // township | city | county
  county            String?
  state             String   @default("MI")
  website           String?
  phone             String?
  buildingDeptLink   String?
  healthDeptLink    String?
  address           String?
  officeHours       String?
  notes             String?
  lastVerified      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  feeItems          FeeItem[]
  sourceDocs        SourceDoc[]
  metricValues      MetricValue[]
}

model MetricDef {
  id                  String   @id @default(cuid())
  key                 String   @unique
  label               String
  unit                String?  // percent | days | count | dollars | formula
  windowYears         Int?     // e.g. 5 for "5-year avg"
  pathResidential     Boolean  @default(true)
  pathCommercial      Boolean  @default(true)
  indexComponent      String?  // regulatory_intensity | predictability | fiscal_burden | transparency
  weight              Float?   // for index computation
  sortOrder           Int      @default(0)

  metricValues        MetricValue[]
}

model MetricValue {
  id             String    @id @default(cuid())
  jurisdictionId String
  metricDefId    String
  valueNumeric   Float?
  valueText      String?
  windowStart    DateTime?
  windowEnd      DateTime?
  lastVerified   DateTime?
  confidence     Float?    // 0-1
  notes         String?

  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  metricDef      MetricDef   @relation(fields: [metricDefId], references: [id], onDelete: Cascade)
  citations      Citation[]
}

model Source {
  id             String    @id @default(cuid())
  url            String    @unique
  title          String?
  publisher      String?
  publishedDate  DateTime?
  retrievedDate  DateTime  @default(now())

  citations      Citation[]
}

model Citation {
  id             String   @id @default(cuid())
  metricValueId  String
  sourceId       String
  quoteSnippet   String?  // max 200 chars
  locatorText    String?  // e.g. "p.3 fee schedule"
  citationLabel  String?  // e.g. "[1]"

  metricValue    MetricValue @relation(fields: [metricValueId], references: [id], onDelete: Cascade)
  source         Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model PermitType {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  category    String?
  sortOrder   Int      @default(0)

  feeItems    FeeItem[]
}

model FeeItem {
  id               String   @id @default(cuid())
  jurisdictionId   String
  permitTypeId     String
  feeName          String
  amount           Float?
  formulaText      String?
  units            String   @default("flat")
  notes            String?
  effectiveDate    DateTime?
  sourceUrl        String?
  lastVerifiedDate DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  jurisdiction     Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  permitType       PermitType   @relation(fields: [permitTypeId], references: [id], onDelete: Cascade)
}

model SourceDoc {
  id             String   @id @default(cuid())
  jurisdictionId String
  url            String
  documentTitle  String?
  publishedDate  DateTime?
  effectiveDate  DateTime?
  filetype       String?
  retrievedDate  DateTime @default(now())
  notes          String?

  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
}

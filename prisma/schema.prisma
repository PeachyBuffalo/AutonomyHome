// AutonomyHome - Pre-Purchase Governance Intelligence Platform
// Neutral, data-driven decision-support for residential & commercial development

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Jurisdiction {
  id                String      @id @default(cuid())
  name              String
  type              String      // township | city | county
  county            String?     // for townships/cities: which county they're in
  website           String?
  phone             String?
  buildingDeptLink  String?
  healthDeptLink    String?
  address           String?
  officeHours       String?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  feeItems             FeeItem[]
  sourceDocs           SourceDoc[]
  governanceMetrics    GovernanceMetric[]
  governanceDimensions GovernanceDimension[]
}

// Measurable indicators — no opinion, no advocacy. Users infer.
model GovernanceMetric {
  id               String   @id @default(cuid())
  jurisdictionId   String
  path             String   // residential | commercial
  metricType       String   // variance_approval_rate | rezoning_approval_rate | permit_processing_days | permit_cost_formula | infrastructure_per_capita | zoning_lawsuits_count | etc.
  metricName       String   // human-readable label
  valueNumeric     Float?   // for rates, counts, days
  valueText        String?  // for formulas, descriptive
  unit             String?  // percent | days | dollars | formula
  year             Int?     // data year
  sourceUrl        String?
  lastVerifiedDate DateTime?
  notes            String?
  createdAt        DateTime @default(now())

  jurisdiction     Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
}

// Dimension scores (0–100) — computed or manual, methodology published
model GovernanceDimension {
  id               String   @id @default(cuid())
  jurisdictionId   String
  path             String   // residential | commercial
  dimension        String   // regulatory_intensity | buildability | development_complexity | tax_burden | transparency | predictability
  score            Int      // 0–100
  methodologyNote  String?  // how this was derived
  lastUpdated      DateTime @default(now())

  jurisdiction     Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
}

model PermitType {
  id          String   @id @default(cuid())
  slug        String   @unique // building, electrical, plumbing, mechanical, zoning, driveway, septic, well, soil_eval
  name        String
  description String?
  category    String?  // e.g. "building", "trade", "environmental"
  sortOrder   Int      @default(0)

  feeItems    FeeItem[]
}

model FeeItem {
  id               String   @id @default(cuid())
  jurisdictionId   String
  permitTypeId     String
  feeName          String   // e.g. "Residential septic permit – new"
  amount           Float?   // flat amount when units = flat
  formulaText      String?  // e.g. "$X per $1,000 valuation"
  units            String   @default("flat") // flat | per_thousand_valuation | per_sqft | per_acre | other
  notes            String?
  effectiveDate    DateTime?
  sourceUrl        String?
  lastVerifiedDate DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  jurisdiction     Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  permitType       PermitType   @relation(fields: [permitTypeId], references: [id], onDelete: Cascade)
}

model SourceDoc {
  id             String   @id @default(cuid())
  jurisdictionId String
  url            String
  documentTitle  String?
  publishedDate  DateTime?
  effectiveDate  DateTime?
  filetype       String?  // pdf, html
  retrievedDate  DateTime @default(now())
  notes          String?

  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
}

# Required: persistent SQLite location for production.
# For container deploys, mount /app/prisma as a persistent volume.
DATABASE_URL="file:/app/prisma/dev.db"

# Optional social provider tokens for automated sentiment collection.
X_BEARER_TOKEN=""
FACEBOOK_GRAPH_ACCESS_TOKEN=""
NEXTDOOR_EXPORT_PATH="/app/data/nextdoor-export.json"

# Optional runtime settings.
NODE_ENV="production"
PORT="3000"
HOSTNAME="0.0.0.0"
